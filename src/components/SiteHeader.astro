---
import { copy, links, person } from "../content";
import Icons from "./Icons.astro";

const navClass =
  "inline-flex items-center gap-1.5 px-1.5 py-1 text-sm text-muted-foreground transition-opacity hover:text-foreground hover:opacity-100";
---

<a
  href="#work"
  class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground"
>
  <span data-lang="en">{copy.en.skipToWork}</span>
  <span data-lang="de">{copy.de.skipToWork}</span>
</a>
<header class="h-16 max-h-20 bg-background">
  <nav class="mx-auto flex h-16 max-w-3xl items-center justify-end gap-1 px-4 sm:gap-3 sm:px-6" aria-label="Primary">
    <ul class="flex items-center gap-1 sm:gap-3">
      <li>
        <a href={person.githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class={navClass}>
          <Icons name="github" />
          <span class="hidden sm:inline">GitHub</span>
        </a>
      </li>
      <li>
        <a href={person.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class={navClass}>
          <Icons name="linkedin" />
          <span class="hidden lg:inline">LinkedIn</span>
        </a>
      </li>
      <li>
        <a href={person.xUrl} target="_blank" rel="noopener noreferrer" aria-label="X" class={navClass}>
          <Icons name="x" />
          <span class="hidden sm:inline">X</span>
        </a>
      </li>
      <li>
        <a
          href={links.cv.en.href}
          download={links.cv.en.download}
          aria-label={copy.en.nav.downloadCv}
          class={navClass}
          data-lang="en"
        >
          <span>CV</span>
        </a>
        <a
          href={links.cv.de.href}
          download={links.cv.de.download}
          aria-label={copy.de.nav.downloadCv}
          class={navClass}
          data-lang="de"
        >
          <span>CV</span>
        </a>
      </li>
      <li>
        <div
          role="group"
          aria-label={copy.en.nav.language}
          class="inline-flex rounded-[var(--radius)] border border-hair bg-popover p-0.5 shadow-[var(--toggle-shadow)]"
        >
          <button
            type="button"
            data-set-locale="en"
            aria-pressed="true"
            class="min-w-8 rounded-[calc(var(--radius)-1px)] px-2 py-0.5 font-mono text-xs tracking-wide transition-[box-shadow,transform,color,background-color] active:translate-y-px active:shadow-[var(--toggle-inset-active)]"
          >
            EN
          </button>
          <button
            type="button"
            data-set-locale="de"
            aria-pressed="false"
            class="min-w-8 rounded-[calc(var(--radius)-1px)] px-2 py-0.5 font-mono text-xs tracking-wide transition-[box-shadow,transform,color,background-color] active:translate-y-px active:shadow-[var(--toggle-inset-active)]"
          >
            DE
          </button>
        </div>
      </li>
      <li>
        <button
          type="button"
          data-theme-toggle
          aria-label={copy.en.nav.theme}
          aria-pressed="false"
          title={copy.en.nav.themeDark}
          class="inline-flex size-8 items-center justify-center rounded-[var(--radius)] border border-hair bg-popover text-muted-foreground shadow-[var(--toggle-shadow)] transition-opacity hover:text-foreground"
        >
          <Icons name="moon" />
          <Icons name="sun" />
        </button>
      </li>
    </ul>
  </nav>
</header>
